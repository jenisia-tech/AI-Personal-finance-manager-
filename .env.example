# Backend Server Configuration
PORT=5001
NODE_ENV=development

# Database Settings (Local SQLite path or mounted persistent volume in cloud)
DATABASE_FILE=./data/finance.db

# Authentication Secrets (Replace in production! Minimum 32 random characters)
JWT_SECRET=your-super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS Configuration (Single origin or comma-separated origins, e.g. https://your-site.vercel.app,http://localhost:3000)
# Subdomains under .vercel.app and localhost are also automatically accepted by server/app.ts
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration (Set in Vercel Environment Variables when deploying frontend)
# Point this to your live Express backend URL (e.g. https://your-backend-api.onrender.com)
# In local development, leave this commented out or blank so Vite dev proxy handles /api
# VITE_API_URL=https://your-backend-api.onrender.com
